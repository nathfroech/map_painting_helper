{
  "indentWidth": 2,
  "lineWidth": 100,
  "includes": [
    "**/*.{json,jsonc}",
    "**/*.toml",
    "**/*.{yml,yaml}",
    "**/*.md"
  ],
  "excludes": [
    "**/node_modules",
    "**/.next",
    "**/target",
    "**/.venv",
    "**/__pycache__",
    "**/*.lock",
    "**/pnpm-lock.yaml"
  ],
  "plugins": [
    "https://plugins.dprint.dev/json-0.19.4.wasm",
    "https://plugins.dprint.dev/toml-0.6.2.wasm",
    "https://plugins.dprint.dev/g-plane/pretty_yaml-v0.5.0.wasm",
    "https://plugins.dprint.dev/markdown-0.17.8.wasm"
  ],
  "json": {
    "indentWidth": 2,
    "lineWidth": 100,
    "trailingCommas": "never"
  },
  "toml": {
    "indentWidth": 4,
    "lineWidth": 100,
    "comment.forceLeadingSpace": true
  },
  "yaml": {
    "indentWidth": 2
  },
  "markdown": {
    "lineWidth": 100,
    "textWrap": "always"
  }
}
